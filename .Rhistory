# fix_hhsize_cat.R
library(readr)
library(dplyr)
library(lubridate)
in_path  <- "C:/Users/jaeye/Downloads/State profile/Welfare/Graph1_nfhs_pov_all.csv"
out_path <- "C:/Users/jaeye/Downloads/State profile/Welfare/Graph1_nfhs_pov_all_fixed.csv"
# Read as character so Excel-made strings aren't auto-parsed
nonmon_1 <- read_csv(
in_path,
col_types = cols(.default = col_guess(), hhsize_cat = col_character())
)
# Helper: "Date-like" to "M to D"
date_to_range <- function(x_date) paste0(month(x_date), " to ", day(x_date))
normalize_hhsize <- function(x) {
# If column came in as Date
if (inherits(x, "Date")) {
out <- date_to_range(x)
out[is.na(x)] <- NA_character_
return(out)
}
xc  <- as.character(x)
out <- xc
# Case A: strings like "3-Feb", "06-Apr" (no year)
pat_mmm <- grepl("^[0-9]{1,2}-[A-Za-z]{3}$", xc)
if (any(pat_mmm, na.rm = TRUE)) {
d <- suppressWarnings(dmy(paste0(xc[pat_mmm], "-2000"))) # dummy year
out[pat_mmm] <- date_to_range(d)
}
# Case B: Excel serial numbers accidentally exported (rare, but safe)
is_num <- suppressWarnings(!is.na(as.numeric(xc)))
if (any(is_num, na.rm = TRUE)) {
nums <- as.numeric(xc[is_num])
# Excel serials (1900 system) are typically > 20000
is_serial <- !is.na(nums) && nums > 20000
if (any(is_serial)) {
d <- as.Date(nums[is_serial], origin = "1899-12-30")
idx <- which(is_num)[is_serial]
out[idx] <- date_to_range(d)
}
}
# Clean up spacing/case; keep already-correct labels as-is
out <- trimws(out)
out <- sub("^(\\d+)\\s*TO\\s*(\\d+)$", "\\1 to \\2", out, ignore.case = TRUE)
out
}
nonmon_1 <- nonmon_1 %>%
mutate(
hhsize_cat = normalize_hhsize(hhsize_cat),
# lock the order you want in plots/filters
hhsize_cat = factor(hhsize_cat, levels = c("1", "2 to 3", "4 to 6", "7+"))
)
library(dplyr)
library(lubridate)
# Helper: "Date-like" to "M to D"
date_to_range <- function(x_date) paste0(month(x_date), " to ", day(x_date))
normalize_hhsize <- function(x) {
# Case 1: actual Date objects (e.g., 2000-02-03)
if (inherits(x, "Date")) {
out <- date_to_range(x)
out[is.na(x)] <- NA_character_
return(out)
}
xc  <- as.character(x)
out <- xc
# Case 2: strings like "3-Feb" or "06-Apr" (no year provided)
pat_mmm <- grepl("^[0-9]{1,2}-[A-Za-z]{3}$", xc)
if (any(pat_mmm, na.rm = TRUE)) {
d <- suppressWarnings(dmy(paste0(xc[pat_mmm], "-2000")))  # add dummy year
out[pat_mmm] <- date_to_range(d)
}
# Case 3: Excel serials accidentally exported (keep true numbers like "1" as-is)
# Identify entries that are numeric-looking
is_num <- suppressWarnings(!is.na(as.numeric(xc)))
if (any(is_num, na.rm = TRUE)) {
nums <- suppressWarnings(as.numeric(xc[is_num]))
# Vectorized test for serials
is_serial <- !is.na(nums) & nums > 20000
if (any(is_serial, na.rm = TRUE)) {
d <- as.Date(nums[is_serial], origin = "1899-12-30")
out[which(is_num)[is_serial]] <- date_to_range(d)
}
}
# Tidy spacing/case; keep already-correct labels
out <- trimws(out)
out <- sub("^(\\d+)\\s*TO\\s*(\\d+)$", "\\1 to \\2", out, ignore.case = TRUE)
out
}
# Apply
nonmon_1 <- nonmon_1 %>%
mutate(
hhsize_cat = normalize_hhsize(hhsize_cat),
hhsize_cat = factor(hhsize_cat, levels = c("1", "2 to 3", "4 to 6", "7+"))
)
library(dplyr)
library(lubridate)
# Helper: "Date-like" to "M to D"
date_to_range <- function(x_date) paste0(month(x_date), " to ", day(x_date))
normalize_hhsize <- function(x) {
# Case 1: actual Date objects (e.g., 2000-02-03)
if (inherits(x, "Date")) {
out <- date_to_range(x)
out[is.na(x)] <- NA_character_
return(out)
}
xc  <- as.character(x)
out <- xc
# Case 2: strings like "3-Feb" or "06-Apr" (no year provided)
pat_mmm <- grepl("^[0-9]{1,2}-[A-Za-z]{3}$", xc)
if (any(pat_mmm, na.rm = TRUE)) {
d <- suppressWarnings(dmy(paste0(xc[pat_mmm], "-2000")))  # add dummy year
out[pat_mmm] <- date_to_range(d)
}
# Case 3: Excel serials accidentally exported (keep true numbers like "1" as-is)
# Identify entries that are numeric-looking
is_num <- suppressWarnings(!is.na(as.numeric(xc)))
if (any(is_num, na.rm = TRUE)) {
nums <- suppressWarnings(as.numeric(xc[is_num]))
# Vectorized test for serials
is_serial <- !is.na(nums) & nums > 20000
if (any(is_serial, na.rm = TRUE)) {
d <- as.Date(nums[is_serial], origin = "1899-12-30")
out[which(is_num)[is_serial]] <- date_to_range(d)
}
}
# Tidy spacing/case; keep already-correct labels
out <- trimws(out)
out <- sub("^(\\d+)\\s*TO\\s*(\\d+)$", "\\1 to \\2", out, ignore.case = TRUE)
out
}
# Apply
nonmon_1 <- nonmon_1 %>%
mutate(
hhsize_cat = normalize_hhsize(hhsize_cat),
hhsize_cat = factor(hhsize_cat, levels = c("1", "2 to 3", "4 to 6", "7+"))
)
# Save cleaned file
write_csv(nonmon_1, out_path)
cat("Wrote cleaned file to:\n", out_path, "\n")
# Read the files
df1 <- read.csv("C:/Users/jaeye/Downloads/State profile/Welfare/Graph1_nfhs_pov_all_fixed.csv")
df2 <- read.csv("C:/Users/jaeye/Downloads/State profile/Welfare/Graph1_nfhs_pov_all.csv")
# Compare number of rows and columns
dim(df1)
dim(df2)
# Compare column names
setdiff(names(df1), names(df2))  # In df1 but not df2
setdiff(names(df2), names(df1))  # In df2 but not df1
# Find rows that are different
diff_rows <- which(!apply(df1 == df2 | (is.na(df1) & is.na(df2)), 1, all))
# Show the different rows from both files
df1[diff_rows, ]
df2[diff_rows, ]
# Create a mask of differences
diff_mask <- df1 != df2 & !(is.na(df1) & is.na(df2))
# Convert to a long table of differences
diff_df <- which(diff_mask, arr.ind = TRUE) %>%
as.data.frame() %>%
mutate(
Column = colnames(df1)[col],
Row = row,
File1_Value = df1[cbind(row, col)],
File2_Value = df2[cbind(row, col)]
) %>%
select(Row, Column, File1_Value, File2_Value)
print(diff_df)
